{
  "entities": {
    "user_profile": {
      "title": "User Profile",
      "description": "Public profile information and roles.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "tollFreeAccept": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "booking": {
      "title": "Booking",
      "description": "User's booking reservation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "propertyId": { "type": "string" },
        "checkIn": { "type": "string", "format": "date" },
        "checkOut": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "totalPrice": { "type": "number" },
        "guests": { "type": "number" },
        "bookingRef": { "type": "string" },
        "guestPhone": { "type": "string" },
        "selectedBedroom": { "type": "object" },
        "accessCode": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "propertyId", "checkIn", "checkOut", "status", "totalPrice", "guests", "createdAt", "updatedAt"]
    },
    "pricing_rule": {
      "title": "Pricing Rule",
      "description": "Dynamic pricing settings defined by Admin.",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string" },
        "type": { "type": "string", "enum": ["default", "weekend", "holiday", "custom"] },
        "targetType": { "type": "string", "enum": ["property", "room"] },
        "roomNumber": { "type": "string" },
        "rate": { "type": "number" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["propertyId", "type", "rate", "createdAt"]
    },
    "property": {
      "title": "Property",
      "description": "A rental property.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "hasSmartLock": { "type": "boolean" },
        "frontDoorCode": { "type": "string" },
        "allowIndividualRoomRental": { "type": "boolean" },
        "bedrooms": { "type": "array" },
        "isTestProperty": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "description", "images", "createdAt"]
    },
    "blackout_date": {
      "title": "Blackout Date",
      "description": "Disabled dates defined by Admin.",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "targetType": { "type": "string", "enum": ["property", "room"] },
        "roomNumber": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["propertyId", "date", "createdAt"]
    },
    "lease": {
      "title": "Lease",
      "description": "Approved lease codes mapped to property/tenant details.",
      "type": "object",
      "properties": {
        "leaseCode": { "type": "string" },
        "propertyId": { "type": "string" },
        "propertyNameOrRoom": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "tenantName": { "type": "string" },
        "tenantEmail": { "type": "string" },
        "tenantPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "revoked"] },
        "createdAt": { "type": "string" }
      },
      "required": ["leaseCode", "propertyId", "startDate", "endDate", "tenantName", "tenantEmail", "status", "createdAt"]
    },
    "lease_request": {
      "title": "Lease Request",
      "description": "User requested long/short term bookings leases awaiting manager approval.",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string" },
        "propertyNameOrRoom": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "tenantName": { "type": "string" },
        "tenantEmail": { "type": "string" },
        "tenantPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["propertyId", "propertyNameOrRoom", "startDate", "endDate", "tenantName", "tenantEmail", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user_profile" },
      "description": "Store authenticating users."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/booking" },
      "description": "Store all booking reservations."
    },
    "/pricing_rules/{ruleId}": {
      "schema": { "$ref": "#/entities/pricing_rule" },
      "description": "Store pricing variations."
    },
    "/blackout_dates/{blackoutId}": {
      "schema": { "$ref": "#/entities/blackout_date" },
      "description": "Store blackout/blocked dates."
    },
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/property" },
      "description": "Store property details."
    },
    "/leases/{leaseId}": {
      "schema": { "$ref": "#/entities/lease" },
      "description": "Store approved leases with codes."
    },
    "/lease_requests/{requestId}": {
      "schema": { "$ref": "#/entities/lease_request" },
      "description": "Store client lease request forms."
    }
  }
}
